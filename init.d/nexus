#!/bin/bash
# /etc/init.d/nexus
# debian-compatible nexus startup script.
#
### BEGIN INIT INFO
# Provides:          nexus
# Required-Start:    $remote_fs $syslog $network
# Required-Stop:     $remote_fs $syslog $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Start nexus at boot time
# Description:       Controls the nexus maven repository manager.
### END INIT INFO

DESC="Nexus Maven Repository Manager"
NAME=nexus
SCRIPTNAME=/etc/init.d/$NAME

# Machine-specific overrides (NEXUS_HOME, NEXUS_DATA_DIR, NEXUS_JAVA_HOME,
# memory settings, ...) belong in /etc/default/nexus, not in this file --
# see README.md. Keeping this script itself unedited means re-running
# setup.sh (which re-symlinks this file from the checkout) never clobbers
# local configuration.
test -r /etc/default/nexus && . /etc/default/nexus

NEXUS_HOME=${NEXUS_HOME:-/opt/nexus3}
NEXUS=$NEXUS_HOME/bin/nexus
NEXUS_DATA_DIR=${NEXUS_DATA_DIR:-/opt/sonatype-work/nexus3}
NEXUS_LOG=$NEXUS_DATA_DIR/log/console.log
NEXUS_USER=${NEXUS_USER:-nexus}

# Official Sonatype distributions (e.g. Community's /opt/nexus-3.91.1-04)
# bundle their own JDK and their launcher explicitly detects and prefers it
# (see that install's bin/nexus: `EMBEDDED_JDK="$(realpath jdk/temurin_*...)"`).
# Nexus Core OSS built from the public nexus-public export uses a different,
# simpler launcher template with no such bundled-JDK detection -- it just
# falls back to JAVA_HOME, or failing that whatever `java` is first on
# PATH. If your system default `java` is older than whatever the current
# release requires, launch will die with "JVM must be greater than N" --
# set NEXUS_JAVA_HOME in /etc/default/nexus to a suitable JDK to fix that.
# Left unset here (empty), meaning: trust JAVA_HOME/PATH as already
# configured for the service user.
NEXUS_JAVA_HOME=${NEXUS_JAVA_HOME:-}

# The launcher's own default (2703m for all three) is hardcoded as a
# fallback inside its script template, which gets fully regenerated by
# bin/build.sh on every upgrade -- editing that file directly would not
# survive the next upgrade.sh run. Override these in /etc/default/nexus
# instead if the default is wrong for your hardware.
NEXUS_JAVA_MIN_MEM=${NEXUS_JAVA_MIN_MEM:-2703m}
NEXUS_JAVA_MAX_MEM=${NEXUS_JAVA_MAX_MEM:-2703m}
NEXUS_DIRECT_MAX_MEM=${NEXUS_DIRECT_MAX_MEM:-2703m}

# $NEXUS's own launcher script computes its own realpath by capturing the
# caller's cwd, cd-ing around to resolve symlinks, then cd-ing back to that
# captured cwd -- and that restore happens as $NEXUS_USER (see the `sudo
# -u` calls below), not whoever invoked this script. `sudo` preserves the
# caller's cwd for the child process by default, so if this script is run
# from a directory $NEXUS_USER can't read (e.g. a sysadmin's home-directory
# checkout of this project), that restore `cd` fails partway through, the
# launcher silently ends up with a bogus/empty KARAF_HOME, and it dies
# with a confusing "KARAF_HOME is not valid" error that has nothing to do
# with the real cause. Pinning our own cwd to somewhere every user can
# always read sidesteps the whole class of failure regardless of where
# this script happens to be invoked from.
cd /

# Official Sonatype distributions (Community's bin/nexus) have their own
# ~50-line start/stop/status block with pidfile handling, built by their
# install4j-based packaging tooling. Nexus Core OSS built from the public
# nexus-public export has no such thing -- its launcher only recognizes
# `clean`, `debug`, `debugs`, `run`/`console`, `server`, `daemon`, and
# `client`; anything else (including "start" and "stop") falls through to
# its default case, which just launches the JVM in the *foreground*
# (confirmed 2026-09-06: `$NEXUS stop` on a not-yet-started Core instance
# actually launched it, and `$NEXUS start` blocked the calling terminal
# indefinitely instead of returning). Rather than depend on whichever
# edition happens to be symlinked in having real service-control support,
# we implement start/stop/status ourselves, uniformly, by backgrounding
# `$NEXUS run` (the one action every version of this launcher does
# support) and finding it again afterwards by process pattern -- the same
# "don't trust a pidfile, match the real process" approach bin/restart.sh
# already uses for its post-action polling, and for the same reason: a
# stale pidfile from whichever edition ran previously would be actively
# misleading here.
#
# "nexus-repository" is deliberately not "org.sonatype.nexus" or
# "sonatype-nexus-repository" -- neither of those strings actually
# appears in either edition's real command line (verified directly
# against the running processes 2026-09-06), so both were silently
# vacuous. "nexus-repository" is a substring of both jar names actually
# in use: sonatype-nexus-repository-*.jar (Community) and
# nexus-repository-core-*.jar (Core OSS).
NEXUS_PATTERN=nexus-repository

nexusPid() {
  pgrep -u "$NEXUS_USER" -f "$NEXUS_PATTERN"
}

startNexus() {
  pid=$(nexusPid)
  if [ -n "$pid" ]; then
    echo "Nexus already running (pid $pid)"
    return 0
  fi
  echo "Starting nexus"
  mkdir -p "$(dirname "$NEXUS_LOG")"
  # `nohup ... &` alone is not enough: it survives the controlling terminal
  # hanging up, but the process still belongs to whatever login session's
  # cgroup was active when this script was invoked (e.g. a sysadmin's
  # `sudo /etc/init.d/nexus start` shell). Ubuntu defaults to
  # KillUserProcesses=yes, so systemd-logind kills every process still in
  # that scope once the session is fully torn down -- which can happen
  # well after the terminal is closed, not immediately. Confirmed
  # 2026-09-06: a `nohup`'d, `disown`'d Nexus process, verified still
  # running from a second terminal after the first was closed, was killed
  # ~30 minutes later when the first terminal's underlying login session
  # actually ended (see session-*.scope teardown in `journalctl` at that
  # timestamp) -- nohup/disown only detach at the shell level, not from
  # logind's session-scope cgroup. systemd-run --uid=... instead places
  # the process in its own transient unit under system.slice, structurally
  # independent of any login session, which is the actual fix (verified by
  # inspecting the resulting CGroup: path, same day).
  systemd-run --uid="$NEXUS_USER" --unit=nexus-run --collect \
    ${NEXUS_JAVA_HOME:+--setenv=JAVA_HOME="$NEXUS_JAVA_HOME"} \
    --setenv=JAVA_MIN_MEM="$NEXUS_JAVA_MIN_MEM" \
    --setenv=JAVA_MAX_MEM="$NEXUS_JAVA_MAX_MEM" \
    --setenv=DIRECT_MAX_MEM="$NEXUS_DIRECT_MAX_MEM" \
    --property=StandardOutput=append:"$NEXUS_LOG" \
    --property=StandardError=append:"$NEXUS_LOG" \
    "$NEXUS" run
}

stopNexus() {
  pid=$(nexusPid)
  if [ -z "$pid" ]; then
    echo "Nexus not running"
    return 0
  fi
  echo "Stopping nexus (pid $pid)"
  kill -15 $pid
}

statusNexus() {
  pid=$(nexusPid)
  if [ -n "$pid" ]; then
    echo "Nexus is running (pid $pid)"
    return 0
  else
    echo "Nexus is not running"
    return 1
  fi
}

case "$1" in
  start)
    startNexus
    ;;
  stop)
    stopNexus
    ;;
  restart|force-reload)
    stopNexus
    # Give the old process a chance to actually exit before starting the
    # new one -- otherwise both could briefly hold the listening port.
    for _ in $(seq 1 60)
    do
      [ -n "$(nexusPid)" ] || break
      sleep 1
    done
    startNexus
    ;;
  status)
    statusNexus
    ;;
  *)
    echo "Usage: $SCRIPTNAME {start|stop|status|restart|force-reload}" >&2
    exit 3
    ;;
esac
